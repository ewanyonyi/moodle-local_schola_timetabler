<div class="schola-slots-dashboard p-2">
    <!-- Executive Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="mb-0 text-dark font-weight-bold tracking-tight">Schola Timetabler Control Center</h3>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 font-weight-bold small">v1.0 Free</span>
            </div>
            <p class="text-muted small mb-0 mt-1">Local scheduling analytics, venue capacity monitoring, and timetable generation.</p>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <span class="badge bg-secondary-subtle text-dark border border-secondary-subtle px-3 py-2 fs-6 rounded-pill shadow-sm d-flex align-items-center gap-2">
                <i class="fa fa-server"></i> Free Local Engine
            </span>
        </div>
    </div>

    <!-- Engine Mode Alert -->
    <div id="license-notice-alert" class="alert alert-light border shadow-sm text-dark mb-4 rounded-4 p-3" role="alert">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-circle bg-primary text-white me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="fa fa-info-circle fs-5"></i>
                </div>
                <div>
                    <div class="font-weight-bold">{{tier_notice}}</div>
                    <div class="small text-muted">All timetable data stays inside your Moodle installation.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Metrics Cards Grid -->
    <div class="row g-4 my-2">
        <!-- Courses Metric Card -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden" style="border-left: 5px solid {{#is_course_exceeded}}#dc3545{{/is_course_exceeded}}{{^is_course_exceeded}}#16a34a{{/is_course_exceeded}} !important;">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase text-muted font-weight-bold small tracking-wider">Courses Target</span>
                            <span class="badge {{#is_course_exceeded}}bg-danger-subtle text-danger{{/is_course_exceeded}}{{^is_course_exceeded}}bg-success-subtle text-success{{/is_course_exceeded}} rounded-pill px-2.5 py-1 small">Moodle Synced</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <span class="display-5 font-weight-bold text-dark">{{course_count}}</span>
                            <span class="fs-6 text-muted">/ {{max_courses_label}} max capacity</span>
                        </div>
                        <div class="progress mt-3 rounded-pill" style="height: 6px; background-color: #f1f5f9;">
                            <div class="progress-bar {{#is_course_exceeded}}bg-danger{{/is_course_exceeded}}{{^is_course_exceeded}}bg-success{{/is_course_exceeded}} rounded-pill" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <div class="mt-3 small text-muted d-flex justify-content-between align-items-center border-top pt-2">
                        <span>Active Courses in Catalog</span>
                        <i class="fa fa-book text-muted opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Venues Metric Card -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden" style="border-left: 5px solid #2563eb !important;">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase text-muted font-weight-bold small tracking-wider">Campus Venues</span>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 small">Rooms & Labs</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <span class="display-5 font-weight-bold text-dark">{{room_count}}</span>
                            <span class="fs-6 text-muted">Configured Venues</span>
                        </div>
                        <div class="progress mt-3 rounded-pill" style="height: 6px; background-color: #f1f5f9;">
                            <div class="progress-bar bg-primary rounded-pill" role="progressbar" style="width: 85%;" aria-valuenow="85" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <div class="mt-3 d-flex justify-content-between align-items-center border-top pt-2">
                        <span class="small text-muted">Auditoriums, Labs & Classrooms</span>
                        <a href="{{rooms_url}}" class="btn btn-sm btn-link text-primary font-weight-bold text-decoration-none p-0">Manage &rarr;</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Generated Schedules Card -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden" style="border-left: 5px solid #0d9488 !important;">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase text-muted font-weight-bold small tracking-wider">Master Schedules</span>
                            <span class="badge bg-info-subtle text-info rounded-pill px-2.5 py-1 small">Generated</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <span class="display-5 font-weight-bold text-dark">{{schedule_count}}</span>
                            <span class="fs-6 text-muted">Allocated Sessions</span>
                        </div>
                        <div class="progress mt-3 rounded-pill" style="height: 6px; background-color: #f1f5f9;">
                            <div class="progress-bar bg-info rounded-pill" role="progressbar" style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <div class="mt-3 d-flex justify-content-between align-items-center border-top pt-2">
                        <span class="small text-muted">Conflict-free timetable entries</span>
                        <a href="{{schedules_url}}" class="btn btn-sm btn-link text-info font-weight-bold text-decoration-none p-0">View Timetables &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

